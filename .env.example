# Copy this file to ".env" and fill in your values.
# NEVER put real secrets in THIS file — it gets shared. Use your private ".env".

# From your Meta app: Instagram product -> API setup -> Instagram app secret
IG_APP_SECRET=your_instagram_app_secret_here
# The token from the "Generate token" button (paste the WHOLE string)
IG_SHORT_LIVED_TOKEN=your_token_here

# Filled in automatically after the first run (leave blank):
IG_ACCESS_TOKEN=
# Optional: pin the Instagram user ID (resolved automatically otherwise):
IG_USER_ID=

# --- Optional extras ---
# Pull comment text (needs the instagram_business_manage_comments permission):
ENABLE_COMMENTS=false
# Capture live Stories (they vanish from the API after 24h):
ENABLE_STORIES=true
